# Put these in the EXISTING PSNA root .env; never commit actual secrets
SMTP_USER=your-sending-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM=PSNA Feedback <your-sending-address@gmail.com>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECOVERY_HMAC_KEY=replace-with-64-hex-character-random-secret
